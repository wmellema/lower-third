{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"paths": {
			"tally": ["./src/core/index.ts"],
			"tally/*": ["./src/core/*"]
		}
	},
	"include": ["src", "templates", "tests"]
}
